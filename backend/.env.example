# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/racingline

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# FastF1 Cache Directory
FASTF1_CACHE_DIR=.fastf1_cache

# API Configuration
CORS_ORIGINS=["http://localhost:3000","https://*.vercel.app"]

# Model Paths
MODELS_DIR=app/ml_models/weights
LSTM_MODEL_PATH=app/ml_models/weights/lstm_model.pth
REGRESSION_MODEL_PATH=app/ml_models/weights/regression_model.pkl
STRATEGY_MODEL_PATH=app/ml_models/weights/strategy_model.pkl
